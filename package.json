{
  "name": "promptcut-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:prompt-quality": "vitest run tests/unit/prompt-edit-quality-eval.test.ts",
    "media:p5:generate-fixtures": "node scripts/generate-p5-media-fixtures.mjs",
    "test:media:fixtures": "node scripts/p5-media-fixture-check.mjs",
    "test:media:analyze": "node scripts/p5-media-analyze.mjs --manifest tests/fixtures/media/manifests/p5-real-media-fixtures.json",
    "test:media:p5": "node scripts/p5-real-media-runner.mjs",
    "test:media:p5:smoke": "node scripts/p5-real-media-runner.mjs --provider mock --suite smoke --report test-results/p5-real-media-report.json",
    "test:media:p5:codex": "node scripts/p5-real-media-runner.mjs --provider codex-cli --suite smoke --report test-results/p5-real-media-codex-report.json",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.ms-playwright playwright test",
    "playwright:install": "PLAYWRIGHT_BROWSERS_PATH=.ms-playwright playwright install chromium"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@prisma/client": "6.19.0",
    "bullmq": "^5.77.1",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.7",
    "prisma": "6.19.0",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
