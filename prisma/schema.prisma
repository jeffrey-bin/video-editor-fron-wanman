generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StateMeta {
  id        String   @id
  revision  Int      @default(0)
  updatedAt DateTime @updatedAt
}

model ProjectRecord {
  id          String   @id
  name        String
  locale      String
  exportPreset String
  storageRoot String?
  deletedAt   DateTime?
  timeline    Json
  createdAt   DateTime
  updatedAt   DateTime
}

model AssetRecord {
  id           String   @id
  projectId    String
  kind         String
  originalName String
  mimeType     String
  sizeBytes    Int?
  sha256       String?
  originalKey  String?
  proxyKey     String?
  thumbnailKey String?
  waveformKey  String?
  probeStatus  String?
  probeError   String?
  durationMs   Int
  width        Int?
  height       Int?
  fps          Float?
  videoCodec   String?
  audioCodec   String?
  filePath     String?
  thumbnailUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
  @@unique([projectId, originalKey])
}

model JobRecord {
  id             String   @id
  projectId      String?
  type           String
  status         String
  progress       Int
  input          Json
  output         Json?
  error          Json?
  attempts       Int
  maxAttempts    Int
  leaseOwner     String?
  leaseExpiresAt DateTime?
  createdAt      DateTime
  updatedAt      DateTime
  startedAt      DateTime?
  finishedAt     DateTime?

  @@index([status, leaseExpiresAt])
  @@index([projectId])
}

model WorkerHeartbeatRecord {
  runnerId           String   @id
  role               String
  status             String
  version            String
  commitSha          String?
  hostname           String?
  pid                Int?
  startedAt          DateTime
  lastHeartbeatAt    DateTime
  lastJobStartedAt   DateTime?
  lastJobFinishedAt  DateTime?
  currentJobId       String?
  currentQueue       String?
  processedJobsTotal Int      @default(0)
  failedJobsTotal    Int      @default(0)
  metadata           Json?
  updatedAt          DateTime @updatedAt

  @@index([role, lastHeartbeatAt])
  @@index([status])
}

model SchedulerHeartbeatRecord {
  name                   String   @id
  runnerId               String
  status                 String
  intervalSeconds        Int
  lastHeartbeatAt        DateTime
  lastRunStartedAt       DateTime?
  lastRunFinishedAt      DateTime?
  lastRunDurationMs      Int?
  lastScannedRunningJobs Int      @default(0)
  lastRepairedJobs       Json?
  lastRequeuedJobs       Json?
  lastMarkedStalledJobs  Json?
  lastErrorCode          String?
  lastErrorMessage       String?
  updatedAt              DateTime @updatedAt
}

model JobDiagnosticEventRecord {
  id              String   @id @default(cuid())
  jobId           String
  projectId       String?
  type            String
  phase           String
  code            String
  message         String
  retryable       Boolean
  runnerId        String?
  queue           String?
  attempt         Int?
  command         Json?
  stderrPreview   String?
  stdoutPreview   String?
  objectKey       String?
  timelineVersion Int?
  traceId         String?
  createdAt       DateTime @default(now())

  @@index([jobId, createdAt])
  @@index([code, createdAt])
  @@index([projectId, createdAt])
}

model PendingPlanRecord {
  requestId       String   @id
  projectId        String
  timelineVersion  Int
  plan             Json
  state            String
  provider         String
  prompt           String
  createdAt        DateTime
  updatedAt        DateTime
  appliedAt        DateTime?
  expiresAt        DateTime?

  @@index([projectId, state])
}

model ExportFileRecord {
  id        String   @id
  projectId String
  jobId     String
  preset    String
  objectKey String
  sizeBytes Int
  sha256    String?
  durationMs Int
  status    String
  expiresAt DateTime
  createdAt DateTime

  @@index([projectId, status])
  @@unique([objectKey])
}
